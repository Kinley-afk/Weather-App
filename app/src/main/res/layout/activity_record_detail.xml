<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_blue_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/detailTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Record Details"
        android:textColor="@color/deep_blue"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etDetailLocation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:hint="Location name"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_input_field"
        app:layout_constraintTop_toBottomOf="@id/detailTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etDetailTemperature"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:hint="Temperature (°C)"
        android:inputType="numberDecimal"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_input_field"
        app:layout_constraintTop_toBottomOf="@id/etDetailLocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etDetailCondition"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:hint="Weather condition"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_input_field"
        app:layout_constraintTop_toBottomOf="@id/etDetailTemperature"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etDetailHumidity"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:hint="Humidity (%)"
        android:inputType="number"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_input_field"
        app:layout_constraintTop_toBottomOf="@id/etDetailCondition"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etDetailWindSpeed"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:hint="Wind speed (km/h)"
        android:inputType="numberDecimal"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_input_field"
        app:layout_constraintTop_toBottomOf="@id/etDetailHumidity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnUpdateRecord"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:text="Update"
        android:textColor="@color/white"
        android:backgroundTint="@color/sky_blue"
        app:cornerRadius="25dp"
        app:layout_constraintTop_toBottomOf="@id/etDetailWindSpeed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnDeleteRecord"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:text="Delete"
        android:textColor="@color/white"
        android:backgroundTint="@color/error_red"
        app:cornerRadius="25dp"
        app:layout_constraintTop_toBottomOf="@id/btnUpdateRecord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnShareRecord"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:text="Share"
        android:textColor="@color/deep_blue"
        android:backgroundTint="@color/white"
        app:cornerRadius="25dp"
        app:layout_constraintTop_toBottomOf="@id/btnDeleteRecord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>